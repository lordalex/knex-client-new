{
  "openapi": "3.0.0",
  "info": {
    "title": "KNEX Valet Client Gateway API",
    "version": "2.1.0",
    "description": "This is the public-facing API Gateway for the Knex Valet Client application (Firebase Cloud Functions). It acts as a secure proxy, handling authentication (Firebase Auth), CORS, and routing before forwarding requests to the backend logic. It supports both protected (Authenticated) and casual (Public/Kiosk) endpoints.",
    "contact": {
      "name": "API Support",
      "email": "support@knex-app.xyz"
    }
  },
  "servers": [
    {
      "url": "https://us-central1-knex-client24.cloudfunctions.net/api",
      "description": "Production Cloud Functions Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID Token passed in the Authorization header (Bearer scheme)."
      },
      "bodyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "idToken",
        "description": "Legacy support: Firebase ID Token passed inside the JSON request body property 'idToken'."
      }
    },
    "schemas": {
      "ApiRequestWrapper": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Firebase Authentication ID Token (optional if Authorization header is used)."
          },
          "data": {
            "type": "object",
            "description": "The actual payload for the requested operation.",
            "nullable": true
          }
        },
        "example": {
          "idToken": "your-firebase-id-token",
          "data": {
            "modelName": "Ticket",
            "action": "create",
            "payload": {
              "status": "Arrival"
            }
          }
        }
      },
      "ApiResponseWrapper": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates the outcome of the request.",
            "example": "success"
          },
          "message": {
            "type": "string",
            "description": "A human-readable message providing details about the result.",
            "example": "Operation completed successfully."
          },
          "data": {
            "type": "object",
            "description": "The primary data payload of the response.",
            "nullable": true
          },
          "result": {
            "type": "object",
            "description": "Additional results or metadata.",
            "nullable": true
          },
          "error": {
            "type": "string",
            "description": "An error message if the request failed.",
            "nullable": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Internal Server Error: Missing ID Token"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "description": "A valet ticket object.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier for the ticket."
          },
          "ticket_number": {
            "type": "string",
            "description": "The human-readable ticket number."
          },
          "status": {
            "type": "string",
            "enum": [
              "Arrival",
              "Parked",
              "Departure",
              "Completed",
              "Cancelled"
            ],
            "description": "The current status of the valet ticket."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the ticket was created."
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the user."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The user's email address."
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "ATTENDANT",
              "CLIENT"
            ],
            "description": "The role of the user within the system."
          }
        }
      }
    }
  },
  "paths": {
    "/createTicket": {
      "post": {
        "summary": "Create a new Ticket",
        "description": "Generates a new valet ticket for an authenticated user. The request must include vehicle information and the site ID.",
        "operationId": "createTicket",
        "requestBody": {
          "required": true,
          "description": "Request body must contain the ticket data, including vehicle info and site ID.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiRequestWrapper"
              },
              "examples": {
                "CreateNewTicket": {
                  "value": {
                    "idToken": "your-firebase-id-token",
                    "data": {
                      "vehicleInfo": {
                        "make": "Toyota",
                        "model": "Camry",
                        "color": "Blue"
                      },
                      "siteId": "your-site-id"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket created successfully. Returns the newly created ticket object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWrapper"
                },
                "examples": {
                  "Success": {
                    "value": {
                      "status": "success",
                      "message": "Ticket created",
                      "data": {
                        "id": "tck_12345",
                        "ticket_number": "101",
                        "status": "Arrival",
                        "created_at": "2025-11-29T10:00:00Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. The provided ID token is missing, invalid, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "UnauthorizedError": {
                    "value": {
                      "error": "Unauthorized: Invalid token"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/createProvisionalTicket": {
      "post": {
        "summary": "Create Provisional Ticket (Casual)",
        "description": "Creates a ticket without a registered user (e.g., from a kiosk). This endpoint is public and does not require an authentication token. It's used for casual customers who are not registered in the system.",
        "operationId": "createProvisionalTicket",
        "security": [],
        "requestBody": {
          "required": true,
          "description": "The request must contain vehicle information and the site ID.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "vehicleInfo": {
                        "type": "object",
                        "description": "Information about the vehicle."
                      },
                      "siteId": {
                        "type": "string",
                        "description": "The ID of the valet site."
                      }
                    }
                  }
                }
              },
              "examples": {
                "ProvisionalTicket": {
                  "value": {
                    "data": {
                      "vehicleInfo": {
                        "make": "Honda",
                        "model": "Civic",
                        "color": "Black"
                      },
                      "siteId": "your-site-id"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provisional ticket created successfully. The response includes a PIN for the user to retrieve their ticket later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWrapper"
                },
                "examples": {
                  "Success": {
                    "value": {
                      "status": "success",
                      "message": "Provisional ticket created",
                      "data": {
                        "ticketId": "tck_67890",
                        "pin": "1234"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cancelTicket": {
      "post": {
        "summary": "Cancel a Ticket (Alias)",
        "description": "Legacy alias for `/setTicketToCancel`. Updates a ticket's status to 'Cancelled'. Requires authentication.",
        "operationId": "cancelTicketAlias",
        "requestBody": {
          "required": true,
          "description": "Requires the ID of the ticket to be cancelled and a reason for cancellation.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "ticketId": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "ticketId"
                    ]
                  }
                }
              },
              "examples": {
                "CancelRequest": {
                  "value": {
                    "idToken": "your-firebase-id-token",
                    "data": {
                      "ticketId": "tck_12345",
                      "reason": "Customer changed their mind."
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket cancelled successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWrapper"
                }
              }
            }
          }
        }
      }
    },
    "/setTicketToCancel": {
      "post": {
        "summary": "Cancel a Ticket",
        "description": "Canonical endpoint to cancel a ticket. Updates a ticket's status to 'Cancelled'. Requires authentication.",
        "operationId": "setTicketToCancel",
        "requestBody": {
          "required": true,
          "description": "Requires the ID of the ticket to be cancelled.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiRequestWrapper"
              },
              "examples": {
                "CancelRequest": {
                  "value": {
                    "idToken": "your-firebase-id-token",
                    "data": {
                      "ticketId": "tck_12345"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket cancelled successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWrapper"
                }
              }
            }
          }
        }
      }
    },
    "/getTicketList": {
      "post": {
        "summary": "Get List of Tickets",
        "description": "Retrieves a list of tickets, optionally filtered by status. The user's context (e.g., their company or role) is automatically inferred from the authentication token.",
        "operationId": "getTicketList",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "example": "Parked"
                      }
                    }
                  }
                }
              },
              "examples": {
                "FilterByStatus": {
                  "value": {
                    "idToken": "your-firebase-id-token",
                    "data": {
                      "status": "Parked"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A list of tickets matching the criteria.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ticket"
                      }
                    }
                  }
                },
                "examples": {
                  "TicketList": {
                    "value": {
                      "status": "success",
                      "data": [
                        {
                          "id": "tck_123",
                          "ticket_number": "101",
                          "status": "Parked",
                          "created_at": "2025-11-29T10:00:00Z"
                        },
                        {
                          "id": "tck_456",
                          "ticket_number": "102",
                          "status": "Parked",
                          "created_at": "2025-11-29T10:05:00Z"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getTicketByPIN": {
      "post": {
        "summary": "Get Ticket by PIN (Casual)",
        "description": "Retrieves a ticket using a secure PIN. This is a public endpoint for casual users who do not have an account.",
        "operationId": "getTicketByPIN",
        "security": [],
        "requestBody": {
          "required": true,
          "description": "Requires the PIN associated with the ticket.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "pin": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "pin"
                    ]
                  }
                }
              },
              "examples": {
                "GetByPIN": {
                  "value": {
                    "data": {
                      "pin": "1234"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket found and returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWrapper"
                }
              }
            }
          },
          "404": {
            "description": "Invalid PIN. The provided PIN does not match any ticket.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
